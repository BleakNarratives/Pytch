# Copy to .env and fill in your values

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key())")
ENCRYPTION_KEY=your-base64-key-here

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-key

# Email (for Pytch)
PYTCH_EMAIL=your@email.com
PYTCH_EMAIL_PASSWORD=your-gmail-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Yelp API (optional)
YELP_API_KEY=your-yelp-key

# Google Places API (optional)
GOOGLE_PLACES_KEY=your-google-key
